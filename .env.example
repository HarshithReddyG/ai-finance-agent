# Copy this file to .env and fill in values as needed.
# NEVER commit the real .env file — it is already in .gitignore.
# PHASE 1: nothing here is required yet. This file just documents what
# later phases will need, so the shape of config is decided up front.

# --- Database (Phase 3) ---
DATABASE_URL=sqlite:///db/finance.db

# --- LLM provider (Phase 4 / Phase 7) ---
# Choose one: ollama | anthropic | openai
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Plaid Sandbox (Phase 10, optional, later) ---
# Sandbox credentials only — never use production Plaid keys in this project.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
